# Copy to .env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=4000
# Local: mongodb://127.0.0.1:27017/stagnes   Atlas: mongodb+srv://user:pass@cluster/stagnes
MONGODB_URI=mongodb://127.0.0.1:27017/stagnes
# The address people open in the browser (used for the CSRF origin check)
APP_ORIGIN=http://localhost:5173
# How long a login lasts before signing in again
SESSION_TTL_HOURS=12
# Sign out after this many minutes without activity
SESSION_IDLE_MINUTES=60
# Set to 1 when running behind Nginx/a load balancer that terminates HTTPS
TRUST_PROXY=0
# Used to work out "this month" for tributes
TZ_NAME=Africa/Harare
